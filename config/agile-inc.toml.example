[mqtt]
host = "192.168.0.11"
port = 1883
username = "agil"
password = "agil"
base_topic = "agileinc"
client_id_prefix = "agileinc"

[redis]
url = "redis://192.168.0.137:49155"
dedupe_ttl_seconds = 86400

[opencode]
command = "opencode"
default_args = ["--non-interactive"]
workdir = "./"
timeout_seconds = 1800
max_output_kb = 2048

[agents]
log_level = "info"

[llm]
model = "minimax-m2.5:cloud"
temperature = 0.7
max_tokens = 2048
base_url = "http://localhost:11434"

[prompts]
po_system_prompt = "You are a Product Owner agent. Review the story and provide feedback."
max_llm_rounds = 10
